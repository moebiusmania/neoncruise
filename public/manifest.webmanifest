{
  "id": "/",
  "name": "Neon Cruise · Nightride FM",
  "short_name": "Neon Cruise",
  "description": "A retro outrun cassette player for the Nightride FM synthwave radio network.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#05020a",
  "theme_color": "#05020a",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tape shelf", "url": "/?screen=shelf", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Signal FX", "url": "/?screen=fx", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
